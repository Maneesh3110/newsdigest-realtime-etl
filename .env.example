# Flask / News API configuration
NEWS_API_KEY=replace-with-your-newsapi-key
NEWS_LOOKBACK_DAYS=7
NEWS_LANGUAGE=en
NEWS_FALLBACK_COUNTRY=us
NEWS_SORT_BY=publishedAt

# Kafka (set ENABLE_KAFKA=true only if Kafka + confluent-kafka are available)
ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=news_articles

# PySpark toggle (requires pyspark installed)
ENABLE_SPARK=false

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DB_NAME=news_etl
